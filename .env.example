# Salin ke .env.local. Kunci hanya dibaca di server (Route Handler), tidak pernah dikirim ke browser.

# --- Pilihan gratis: Groq untuk transkripsi dan ringkasan ---
# Kunci dari https://console.groq.com/keys (tier gratis, ada batas pemakaian).
GROQ_API_KEY=
TRANSCRIBE_PROVIDER=groq
SUMMARY_PROVIDER=groq

# --- Pilihan lain ---
# TRANSCRIBE_PROVIDER: mock | groq | openai
# SUMMARY_PROVIDER:    mock | groq | claude
# Bawaan bila tidak diisi: mock saat pengembangan, claude (ringkasan) di produksi.

# Model opsional. Bawaan: whisper-large-v3 (groq), whisper-1 (openai),
# openai/gpt-oss-120b (ringkasan groq), claude-haiku-5-5 (ringkasan claude).
# TRANSCRIBE_MODEL=
# SUMMARY_MODEL=

# Kunci transkripsi selain Groq (mis. openai). Untuk groq cukup GROQ_API_KEY.
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=

# Kunci Claude API, wajib bila SUMMARY_PROVIDER=claude.
# ANTHROPIC_API_KEY=

# Penyedia tiruan ditolak di produksi kecuali diizinkan terang-terangan.
# ALLOW_MOCK_AI=1
# Jeda penyedia tiruan dalam milidetik.
# MOCK_AI_DELAY_MS=800

# Batas permintaan /api/process per alamat IP.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
