# Salin ke .env.local. Kunci hanya dibaca di server (Route Handler), tidak pernah dikirim ke browser.

# Ringkasan: "claude" atau "mock". Bawaan: mock saat pengembangan, claude di produksi.
SUMMARY_PROVIDER=mock
# Model untuk ringkasan.
SUMMARY_MODEL=claude-haiku-5-5
# Kunci Claude API, wajib bila SUMMARY_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Transkripsi: "mock" (transkrip contoh, audio diabaikan), "openai", atau "groq".
# Adapter openai/groq belum diuji terhadap API asli.
TRANSCRIBE_PROVIDER=mock
# Wajib untuk openai/groq.
TRANSCRIBE_API_KEY=
# Opsional. Bawaan: whisper-1 (openai), whisper-large-v3 (groq).
# TRANSCRIBE_MODEL=
# TRANSCRIBE_BASE_URL=

# Penyedia tiruan ditolak di produksi kecuali diizinkan terang-terangan.
# ALLOW_MOCK_AI=1
# Jeda penyedia tiruan dalam milidetik.
# MOCK_AI_DELAY_MS=800

# Batas permintaan /api/process per alamat IP.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000
